# WebUI 配置
WEBUI_HOST=0.0.0.0
WEBUI_PORT=7877
MEDIA_OUTPUT_ROOT=./outputs
WEBUI_STATE=./state

# 视觉模型服务
MINICPM_CONTAINER=vision-minicpm
MINICPM_PORT=8002
MINICPM_URL=http://127.0.0.1:8002/v1/chat/completions
MINICPM_HEALTH_URL=http://127.0.0.1:8002/health
MINICPM_STARTUP_TIMEOUT=600
MINICPM_MODEL=MiniCPM-V-4_5-GPTQ
MINICPM_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/vllm/vllm-openai:v0.26.0
MINICPM_MAX_MODEL_LEN=32768
MINICPM_GPU_MEMORY_UTILIZATION=0.90
MINICPM_MAX_IMAGES=8
MODEL_ROOT=/path/to/models
RELEASE_GPU_AFTER_JOB=1

# ASR 与 ForcedAligner 服务
ASR_IMAGE=ragflow-qwen-asr:0.0.6
ASR_CONTAINER=vision-asr
ASR_MAX_NEW_TOKENS=2048
