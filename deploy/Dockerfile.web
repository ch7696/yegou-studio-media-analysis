FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY asset_naming.py ./asset_naming.py
COPY audio_timeline.py ./audio_timeline.py
COPY media_analysis_pipeline.py ./media_analysis_pipeline.py
COPY subtitle_extraction_pipeline.py ./subtitle_extraction_pipeline.py
COPY vision_pipeline.py ./
COPY scripts ./scripts

EXPOSE 7867
CMD ["python3", "app/media_analysis_webui.py", "--host", "0.0.0.0", "--port", "7867"]
